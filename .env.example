# ── Server Network Configuration ──────────────────────────────
PORT=5000
HOST=0.0.0.0

# ── Corporate Intranet Security & JWT ──────────────────────────
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
AUTH_OPTIONAL=false

# ── Initial Seed Credentials Template ───────────────────────────
