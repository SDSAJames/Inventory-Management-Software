AUTH_OPTIONAL=false

# ── Initial Seed Credentials Template ───────────────────────────
ADMIN_KNOX_ID=KNOX-IT-001
ADMIN_NAME=IT Administrator
ADMIN_PASSWORD=change_this_admin_password

OPERATOR_LIST="
    {sample.knox1, Sample Operator 1, password123, Tech Support},
    {sample.knox2, Sample Operator 2, password123, Field Technician}
"
